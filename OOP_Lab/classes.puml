@startuml classes
set namespaceSeparator none

interface CanBeShipped {
  + {abstract} calculate_shipping_cost() : float
}

abstract class Product {
  - product_id : str
  - name : str
  - price : float
  - stock : int
  + display_information() : None
  + get_information_string() : str
  + {abstract} get_fulfilment_info() : str
  + {abstract} {static} from_dict(product_id, details) : Product
  + to_dict() : dict
}

class PhysicalProduct {
  - weight : float
  + calculate_shipping_cost() : float
  + display_information() : None
  + {static} from_dict(product_id, details)
  + {static} from_ui(product_id, name, price, stock)
  + get_fulfilment_info() : str
  + to_dict() : dict
}

class DigitalProduct {
  - download_size : float
  + display_information() : None
  + {static} from_dict(product_id, details)
  + {static} from_ui(product_id, name, price, stock)
  + get_fulfilment_info() : str
  + to_dict() : dict
}

class SubscriptionProduct {
  - duration_months : int
  + subscription_fee : float
  + display_information() : None
  + {static} from_dict(product_id, details)
  + {static} from_ui(product_id, name, price, stock)
  + get_fulfilment_info() : str
  + to_dict() : dict
}

class FileHandling {
  - path : str
  + load_inventory() : tuple[Inventory, str]
  + {static} save_inventory(inventory, delivery_amount, file_name)
}

class Inventory {
  - failed_entries : int
  - inventory : dict
  + add_product(product : Product)
  + calculate_tax() : float
  + display_all() : None
  + next_product_id() : str
  + process_delivery() : int
  + search_product(product_id : str)
  + total_delivery() : int
  + total_shipping_fees() : float
  + update_stock(product_id : str) : bool
  + validate_stock(product, quantity : int) : None
}

Product <|-- PhysicalProduct
Product <|-- DigitalProduct
Product <|-- SubscriptionProduct
CanBeShipped <|.. PhysicalProduct
Inventory o-- Product
FileHandling ..> Inventory

@enduml